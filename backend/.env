# Copy to .env.example and edit. Never commit the real .env.example file.

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-use-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,suremedra-api.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:8000

# --- Database (leave empty for local SQLite; use PostgreSQL in production) ---
# DATABASE_URL=postgres://suremedra:password@localhost:5432/suremedra

# --- Background jobs (leave empty to run tasks inline without Redis) ---
# REDIS_URL=redis://localhost:6379/0

# --- Email (console backend prints emails in the terminal while DEBUG=true) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=notifications@yourdomain.com
# EMAIL_HOST_PASSWORD=google-app-password
# DEFAULT_FROM_EMAIL=Suremedra <notifications@yourdomain.com>
ADMIN_NOTIFICATION_EMAILS=

# --- Company details printed on invoices ---
COMPANY_NAME=Suremedra Enterprises Private Limited
COMPANY_ADDRESS=Plot 14, Sector 6, Industrial Area, Gurugram, Haryana 122001, India
COMPANY_GSTIN=
COMPANY_EMAIL=enquiries@suremedra.com
COMPANY_PHONE=

# --- Security ---
ADMIN_2FA=false
TURNSTILE_SECRET_KEY=
NUM_PROXIES=0

# --- AWS (production only; leave empty to store files locally) ---
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_TO_FILE=true
LOG_DIR=logs
