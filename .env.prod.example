# Copy to .env.example.prod on the server and fill in every value. Never commit .env.example.prod.
# Keep values on ONE line, without quotes.

# ---------------- domains (no https://) ----------------
DOMAIN=www.example.com
REDIRECT_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
ACME_EMAIL=you@example.com

# ---------------- database ----------------
# Use letters and digits only in the password (generate: openssl rand -hex 24)
POSTGRES_USER=suremedra
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=suremedra
DATABASE_URL=postgres://suremedra:CHANGE_ME_DB_PASSWORD@db:5432/suremedra

# ---------------- Django ----------------
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
DJANGO_DEBUG=false
# 'api' is needed because the Next.js server calls Django inside Docker as http://api:8000
DJANGO_ALLOWED_HOSTS=www.example.com,admin.example.com,api,localhost
CSRF_TRUSTED_ORIGINS=https://www.example.com,https://admin.example.com
SITE_URL=https://www.example.com
ADMIN_URL=https://admin.example.com
NUM_PROXIES=1
REDIS_URL=redis://redis:6379/0
ADMIN_2FA=false

# ---------------- logging ----------------
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_TO_FILE=false

# ---------------- email (Phase 1: Google Workspace mailbox) ----------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=notifications@example.com
EMAIL_HOST_PASSWORD=CHANGE_ME_GOOGLE_APP_PASSWORD
DEFAULT_FROM_EMAIL=Suremedra <notifications@example.com>
# Extra people who should get new-enquiry alerts (comma separated)
ADMIN_NOTIFICATION_EMAILS=

# ---------------- company details on invoices ----------------
COMPANY_NAME=Suremedra Enterprises Private Limited
COMPANY_ADDRESS=Plot 14, Sector 6, Industrial Area, Gurugram, Haryana 122001, India
COMPANY_GSTIN=
COMPANY_EMAIL=enquiries@example.com
COMPANY_PHONE=

# ---------------- AWS ----------------
# Bucket for invoice PDFs (folder media/) and database backups (folder backups/).
# No access keys are needed: the server uses its IAM role.
AWS_STORAGE_BUCKET_NAME=suremedra-prod-files-CHANGE-ME
AWS_S3_REGION_NAME=ap-south-1
BACKUP_S3_BUCKET=suremedra-prod-files-CHANGE-ME

# ---------------- anti-spam (optional, free) ----------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
